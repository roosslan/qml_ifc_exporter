####### Install

install_target: first FORCE
	@if not exist C:$(INSTALL_ROOT)\Root\main_addin\addinExporterProjects\qml_IFC_exporter\EXPORTWINDOW\exportToWindow mkdir C:$(INSTALL_ROOT)\Root\main_addin\addinExporterProjects\qml_IFC_exporter\EXPORTWINDOW\exportToWindow & if not exist C:$(INSTALL_ROOT)\Root\main_addin\addinExporterProjects\qml_IFC_exporter\EXPORTWINDOW\exportToWindow exit 1
	-$(INSTALL_FILE) $(DESTDIR_TARGET) C:$(INSTALL_ROOT)\Root\main_addin\addinExporterProjects\qml_IFC_exporter\EXPORTWINDOW\exportToWindow\$(TARGET)
	-$(INSTALL_FILE) debug\exportToWindow.pdb C:$(INSTALL_ROOT)\Root\main_addin\addinExporterProjects\qml_IFC_exporter\EXPORTWINDOW\exportToWindow\exportToWindow.pdb

uninstall_target: FORCE
	-$(DEL_FILE) C:$(INSTALL_ROOT)\Root\main_addin\addinExporterProjects\qml_IFC_exporter\EXPORTWINDOW\exportToWindow\$(TARGET) 
	 -$(DEL_FILE) C:$(INSTALL_ROOT)\Root\main_addin\addinExporterProjects\qml_IFC_exporter\EXPORTWINDOW\exportToWindow\exportToWindow.pdb
	-$(DEL_DIR) C:$(INSTALL_ROOT)\Root\main_addin\addinExporterProjects\qml_IFC_exporter\EXPORTWINDOW\exportToWindow 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

